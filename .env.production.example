# PRISMA Cloud Production Environment Configuration
PRISMA_ENV=production
PORT=8080
HOST=0.0.0.0

# Database Connection (SQLite local or PostgreSQL cloud)
DATABASE_URL=postgresql://prisma_admin:SecurePass2026@postgres-db:5432/prisma_prod

# JWT Authentication & Cryptographic Salts
SECRET_KEY=PRISMA_SUPER_SECURE_HMAC_SHA256_KEY_PRODUCTION_2026_LIVE
JWT_EXPIRATION_HOURS=24

# Security CORS Origins (Restricted Enterprise Domains)
ALLOWED_ORIGINS=https://studio.prisma.ai,https://app.prisma.ai

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
